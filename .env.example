# Neon Postgres connection string (pooled connection recommended)
# Get this from the Neon dashboard: https://console.neon.tech
DATABASE_URL=

# Login credentials that gate the /list signups page
LIST_AUTH_USER=
LIST_AUTH_PASSWORD=

# Random secret used to sign the /list session cookie (e.g. `openssl rand -hex 32`)
LIST_AUTH_SECRET=

# S3 (or S3-compatible) storage holding downloadable documents
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=              # only needed for non-AWS S3-compatible storage
S3_FORCE_PATH_STYLE=      # "true" for some S3-compatible providers
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CONCEPT_NOTE_KEY="MoYS UNGA_YPS Concept Note_Public Final.pdf"
PATHWAYS_VISION_KEY="MoYS_PATHWAYS_Vision Document.pdf"
